---
import imgSJSULogo from '../assets/img/sjsu-wug-logo.png';
---
<div class="title">
    <img class="inline-logo" src={imgSJSULogo.src} alt="SJSU logo">
    <h1>
        BayPhon @ SJSU 2026
    </h1>
</div>

<style>
div.title {
    display: flex;
    align-items: center;
    background-color: var(--rgb-blue);
    color: var(--rgb-bg);
    padding: 0rem 2rem;
    gap: 1rem;
    & > .inline-logo {
        width: 3rem;
        aspect-ratio: 1;
    }
}
</style>