---
import UnderConstruction from '../../components/UnderConstruction.astro';
import Layout from '../../layouts/Layout.astro';
import Program from '../../assets/bayphon2026_program.pdf'
import StatueImg from '../../assets/img/hr-olympic-black-power.jpg'
---

<Layout webptitle="BayPhon2026 @ SJSU: Program" >
    <h2>Program</h2>
	<p>
        If you haven't already, please sign up at <a href="https://docs.google.com/forms/d/e/1FAIpQLSeVycQgredZZ5Mm7XmWrQV4ABSCaKyAtGqBb-tZnCRD0YdaDw/viewform" target="_blank">this link</a> so we can calculate attendance and headcount!
	</p>

    <embed src={Program} width="500" height="375" type="application/pdf">
    
        <!--
    <img class="salute-statue" src={StatueImg.src} alt="victory salute statue">
    <div class="caption">Victory Salute, Photographer: Hunter Ridenour (2022)</div>
	    -->
    <p>
        <a href={Program} target="_blank">Open in a new tab</a>
    </p>
</Layout>
<style>
    img.salute-statue {
        width: min(40vw, 40vh)
    }
    div.caption {
        font-size: 0.6rem;
    }
    embed {
        width: 100%;
    }
</style>